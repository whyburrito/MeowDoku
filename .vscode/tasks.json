{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build MeowDoku C++",
      "type": "shell",
      "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-g",
        "${workspaceFolder}/MeowDoku.cpp",
        "-o",
        "${workspaceFolder}/MeowDoku.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
